  "type": "module",
  "exports": {
    "./extensions/config": "./extensions/config.ts",
    "./extensions/local-ai": "./extensions/local-ai.ts",
    "./extensions/ollama": "./extensions/ollama.ts",
    "./extensions/lmstudio": "./extensions/lmstudio.ts",
    "./extensions/omlx": "./extensions/omlx.ts",
    "./extensions/geniex": "./extensions/geniex.ts",
    "./extensions/osaurus": "./extensions/osaurus.ts"
  },
  "scripts": {
    "build": "tsgo -p tsconfig.json",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
