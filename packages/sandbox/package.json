{
  "name": "@scaryrawr/pi-mxc",
  "version": "0.1.0",
  "description": "MXC-backed bash sandboxing for pi",
  "keywords": [
    "mxc",
    "pi-package",
    "sandbox"
  ],
  "license": "MIT",
  "author": "Mike Wallio",
  "files": [
    "extensions",
    "docs",
    "README.md",
    "pi-mxc.example.json"
  ],
  "type": "module",
  "scripts": {
    "build": "tsrs -p ./tsconfig.json",
    "fmt": "oxfmt --ignore-path .gitignore ./extensions/*.ts ./tests/*.ts *.json *.md docs/*.md .oxfmtrc.json",
    "fmt:check": "oxfmt --check --ignore-path .gitignore ./extensions/*.ts ./tests/*.ts *.json *.md docs/*.md .oxfmtrc.json",
    "lint": "oxlint -c ../../.oxlintrc.json --tsconfig ./tsconfig.json ./extensions/*.ts ./tests/*.ts",
    "lint:fix": "oxlint -c ../../.oxlintrc.json --fix --tsconfig ./tsconfig.json ./extensions/*.ts ./tests/*.ts",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:run": "pnpm test",
    "test:integration": "vitest run tests/mxc.integration.test.ts",
    "test:rpc": "python3 tests/verify-rpc.py",
    "check": "pnpm build && pnpm lint && pnpm fmt:check && pnpm test"
  },
  "dependencies": {
    "@microsoft/mxc-sdk": "catalog:runtime"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "catalog:pi",
    "@earendil-works/pi-coding-agent": "catalog:pi",
    "@earendil-works/pi-tui": "catalog:pi",
    "@types/node": "catalog:types",
    "oxfmt": "catalog:lint",
    "tsrs": "catalog:typescript",
    "typebox": "catalog:runtime",
    "vitest": "catalog:test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "pi": {
    "extensions": [
      "./extensions/mxc.ts"
    ]
  }
}
