  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:pi",
    "@earendil-works/pi-tui": "catalog:pi",
    "@types/node": "catalog:types",
    "@typescript/native-preview": "catalog:typescript",
    "oxfmt": "catalog:lint",
    "typebox": "catalog:runtime"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "extensions/local-ai.ts",
      "extensions/ollama.ts",
      "extensions/osaurus.ts",
      "extensions/lmstudio.ts",
      "extensions/omlx.ts",
      "extensions/geniex.ts"
    ]
  }
