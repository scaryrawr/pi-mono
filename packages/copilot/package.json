{
  "name": "pi-copilot",
  "version": "1.0.0",
  "description": "auto mode for pi",
  "license": "MIT",
  "author": "Mike Wallio",
  "type": "module",
  "scripts": {
    "build": "tsgo -p ./tsconfig.json",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint -c ../../.oxlintrc.json --tsconfig ./tsconfig.json ./extensions/*.ts ./extensions/**/*.ts",
    "lint:fix": "oxlint -c ../../.oxlintrc.json --fix --tsconfig ./tsconfig.json ./extensions/*.ts ./extensions/**/*.ts",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "catalog:pi",
    "@earendil-works/pi-coding-agent": "catalog:pi",
    "@types/node": "catalog:types",
    "@typescript/native-preview": "catalog:typescript",
    "oxfmt": "catalog:lint",
    "typebox": "catalog:runtime",
    "vitest": "catalog:test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/copilot.ts"
    ]
  }
}
