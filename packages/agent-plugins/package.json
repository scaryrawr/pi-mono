{
  "name": "pi-agent-plugins",
  "version": "0.1.0",
  "description": "Agent Plugins package loader for pi",
  "keywords": [
    "agent-plugins",
    "pi-package"
  ],
  "license": "MIT",
  "author": "Mike Wallio",
  "type": "module",
  "scripts": {
    "build": "tsgo -p ./tsconfig.json",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint -c ../../.oxlintrc.json --tsconfig ./tsconfig.json src/*.ts",
    "lint:fix": "oxlint -c ../../.oxlintrc.json --fix --tsconfig ./tsconfig.json src/*.ts",
    "test": "vitest run",
    "test:run": "pnpm test"
  },
  "dependencies": {
    "yaml": "catalog:runtime"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:pi",
    "@types/node": "catalog:types",
    "@typescript/native-preview": "catalog:typescript",
    "oxfmt": "catalog:lint",
    "typebox": "catalog:runtime",
    "vitest": "catalog:test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.1",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
